# cc-control settings for this machine. Copy to %USERPROFILE%\.cc-control\config.env and fill in
# what you use; leave the rest commented out. Variables already set in the environment win.
# The server reads this when it starts (restart it after a change). `pnpm run doctor` checks it.
# Tokens stay on this machine and never reach the page.

# ---- Jira ---------------------------------------------------------------------------------------
# Data Center / Server: a personal access token (Jira: your avatar > Profile > Personal Access Tokens).
# Include any context path in the site, e.g. https://jira.company.local/jira
#CC_CONTROL_JIRA_SITE=https://jira.company.local
#CC_CONTROL_JIRA_TOKEN=
# Jira Cloud instead: the site is https://you.atlassian.net, the token an API token, plus your email.
#CC_CONTROL_JIRA_EMAIL=you@company.com
# Which issues land in the Inbox (default: assigned to you and not done).
#CC_CONTROL_JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC
# The Inbox's "Ready for QA" view (v): by default status = "Ready for QA" in the projects your own
# tickets come from. Set your own JQL, or off to leave the view empty.
#CC_CONTROL_JIRA_QA_JQL=status = "Ready for QA" AND project = WSS ORDER BY updated DESC
# The QA reviewer shown on Ready for QA tickets: found by the field's name ("QA Reviewer", "QA Assignee",
# "Tester"…). Name the field here if it is called something else, or off to hide it.
#CC_CONTROL_JIRA_QA_FIELD=customfield_12345
# When acceptance criteria live in their own field instead of the description:
#CC_CONTROL_JIRA_AC_FIELD=customfield_12345

# ---- Azure DevOps / TFS (pull requests from Ship) ---------------------------------------------------
# A personal access token with Code: Read & write (TFS: your avatar > Security > Personal access tokens).
#CC_CONTROL_ADO_TOKEN=
# Only for SSH remotes on-prem, which don't say the server's web address:
#CC_CONTROL_ADO_URL=https://tfs.company.local/tfs/DefaultCollection
# Only if the version probe picks wrong (TFS 2018: 4.1, Azure DevOps Server 2019: 5.0, 2020: 6.0, 2022: 7.0):
#CC_CONTROL_ADO_API_VERSION=5.0

# ---- GitHub --------------------------------------------------------------------------------------
# Nothing here: Ship uses the gh CLI. Install it and run `gh auth login` once.

# ---- Certificates ----------------------------------------------------------------------------------
# The certificates Windows trusts are trusted automatically (company servers with an internal CA).
# If a server still fails with "unable to get local issuer certificate", export its root CA as PEM:
#CC_CONTROL_CA_FILE=C:\certs\company-root.pem
# Turn the Windows ones off:
#CC_CONTROL_SYSTEM_CA=0

# ---- Trello --------------------------------------------------------------------------------------
#CC_CONTROL_TRELLO_KEY=
#CC_CONTROL_TRELLO_TOKEN=
#CC_CONTROL_TRELLO_BOARDS=

# ---- The server ----------------------------------------------------------------------------------
#CC_CONTROL_PORT=7777
# Pin the model every card and app session starts with (otherwise your Claude Code default):
#CC_CONTROL_MODEL=claude-sonnet-5-5
# claude.exe, if it isn't on PATH:
#CC_CONTROL_CLAUDE=C:\Users\you\.local\bin\claude.exe
# Cards' terminals get a channel (type to them and answer y / n from the card). 0 turns it off: plain claude.
#CC_CONTROL_CHANNEL=1
# Local ports Try it picks from, one per API and UI of a stack run, so two cards can run the same stack at once:
#CC_CONTROL_PORTS=18000-18999
# Anything else here reaches the steps Try it runs as %NAME%: a kubeconfig per environment, say.
#KUBECONFIG_DEV=C:\Users\you\.kube\dev.yaml
#KUBECONFIG_UAT=C:\Users\you\.kube\uat.yaml
# Log every channel message both ways to %TEMP%\cc-control-channel.log:
#CC_CONTROL_DEBUG=0

# ---- Rarely --------------------------------------------------------------------------------------
# Jira: say which kind it is when the address doesn't tell (server = Data Center / Server, cloud = Jira Cloud):
#CC_CONTROL_JIRA_KIND=server
# Another settings file (set in the environment, not here):
#CC_CONTROL_CONFIG=D:\team\cc-control.env
# Another database file:
#CC_CONTROL_DB=D:\data\cc-control.db
# Phone access over Tailscale (see server/remote.ts); CC_CONTROL_REMOTE_IP picks the interface:
#CC_CONTROL_REMOTE=1
#CC_CONTROL_REMOTE_IP=100.64.0.5
# (CC_CONTROL_WEB_DIST, CC_CONTROL_GH and CC_CONTROL_DEV are for the test scripts and pnpm dev.)
